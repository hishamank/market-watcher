{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "FEED",
        "SIM_SEED",
        "CHAOS_SCOPE",
        "NEXT_PUBLIC_GATEWAY_URL",
        "SITE_URL",
        "VERCEL_ENV",
        "ALLOWED_ORIGINS"
      ]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_GATEWAY_URL", "SITE_URL", "VERCEL_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {}
  }
}
