{
  "name": "mini-trading-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && tsc -p .",
    "test": "node scripts/check-adrs.ts && turbo run test",
    "lint": "oxlint --deny-warnings --ignore-pattern '**/lint-fixtures/**'",
    "lint:fixtures": "node scripts/lint-fixtures.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:direction": "node scripts/check-direction.ts apps/web",
    "check:adrs": "node scripts/check-adrs.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.7",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "turbo": "2.11.13",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=10.30.2 <11"
  },
  "packageManager": "pnpm@10.30.2"
}
