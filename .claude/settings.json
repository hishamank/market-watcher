{
  "permissions": {
    "deny": [
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main*)",
      "Bash(git push*/main*)",
      "Bash(git push*+*)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(git -C * push*)",
      "Bash(git -c * push*)",
      "Bash(gh pr merge*)",
      "Bash(gh api*merge*)",
      "Read(**/.env*)",
      "Read(!**/.env.example)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
