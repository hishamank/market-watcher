# Copy to .env and export in your shell. The gateway does not load .env by itself.

# Gateway

# Gateway port. The verify skill and Playwright set their own.
PORT=4000
# Interface the gateway binds to. Use 0.0.0.0 so a phone on the same Wi-Fi can reach it (Expo Go).
HOST=localhost
# Where prices come from: simulator (default) or alpaca. Alpaca mode needs both keys and never falls back to the simulator.
FEED=simulator
# Simulator seed. The same seed and time give the same prices. E2E and the verify skill use 42.
SIM_SEED=demo-v1
# Comma-separated client origins allowed on the socket and REST (ADRs 0028, 0042). Defaults to the two local web origins.
# React Native sends an Origin too, so for Expo Go add the gateway's LAN origin, for example http://192.168.0.130:4000.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
# Trust X-Forwarded-For from a proxy: true, a hop count, or comma-separated IPs or CIDRs. Set it behind Fly's proxy, or every user shares one rate-limit budget.
TRUST_PROXY=false
# REST requests per minute per IP. Production keeps 120; only the E2E launcher raises it, because every test shares one IP.
REST_RATE_LIMIT_MAX=120

# Alpaca (FEED=alpaca only). Paper-trading keys. Never commit real values.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Optional overrides. The defaults are shown.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# Web

# Where the web app reaches the gateway, read on the server at request time.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Mobile (Expo reads apps/mobile/.env or the shell, not this root file)

# Where the Expo app reaches the gateway. On a phone, use the gateway's LAN address; on the Android emulator, http://10.0.2.2:4000.
EXPO_PUBLIC_GATEWAY_URL=http://localhost:4000
