FROM node:26.12.0-bookworm-slim

RUN npm install --global pnpm@10.30.2
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/gateway/package.json apps/gateway/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN pnpm install --frozen-lockfile --filter @mini/gateway...

COPY apps/gateway/src apps/gateway/src
COPY apps/gateway/data apps/gateway/data
COPY packages/contracts/src packages/contracts/src

ARG GATEWAY_REVISION=unknown
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4000 CHAOS_SCOPE=connection GATEWAY_REVISION=$GATEWAY_REVISION
USER node
EXPOSE 4000
CMD ["./apps/gateway/node_modules/.bin/tsx", "apps/gateway/src/main.ts"]
